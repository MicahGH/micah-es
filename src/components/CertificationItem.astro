---
interface Props{
    logo: any
    issuer?: string
    title: string
    date: string
    description: string
}
const {logo: Logo, issuer, title, date, description} = Astro.props
---

<article class="h-full rounded-3xl border border-white/10 bg-white/5 p-6">
  <div class="flex h-full flex-col items-center">
    {typeof Logo === "string" ? Logo + " " : <Logo class="size-15" />}

    {issuer && (
      <div class="text-sm text-center text-white">
        {issuer}
      </div>
    )}

    <h2 class="text-center font-semibold text-[#C9A227]">
      {title}
    </h2>

    <div class="text-center text-xs text-white/60">
      {date}
    </div>

    <p class="mt-4 flex-1 text-left text-white whitespace-pre-line">
      {description}
    </p>
  </div>
</article>