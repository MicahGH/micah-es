---
import OpenUniversity from "../icons/OpenUniversity.astro";
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

interface EducationEntry {
  degree: string;
  institution: string;
  startDate: string;
  startDateISO: string;
  endDate: string;
  endDateISO?: string;
  description: string;
  logo?: AstroComponentFactory;
  logoAlt: string;
  borderColor?: string;
  backgroundColor?: string;
  color?: string;
}

const EDUCATION: EducationEntry[] = [
  {
    degree: 'BSc (Hons) Computer Science with Artificial Intelligence',
    institution: 'The Open University',
    startDate: 'February 2027',
    startDateISO: '2027-02',
    endDate: 'Ongoing',
    description:
      'Explores programming, mathematics, algorithms, machine learning, applied AI and ethics, alongside a substantial computing project.',
    logo: OpenUniversity,
    logoAlt: 'OU',
    borderColor: '#1E4C9B',
    backgroundColor: '#FFFFFF',
    color: '#1E4C9B',
  },
];
---

<div class="grid gap-5">
  {
    EDUCATION.map((education) => (
      <article class="education-card rounded-xl border border-default-medium bg-neutral-secondary-medium p-5 sm:p-6">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
          <div
            class="institution-logo shrink-0"
            aria-hidden={education.logo ? undefined : 'true'}
            style={`--institution-logo-border: ${education.borderColor ?? 'rgb(201 162 39 / 0.35)'}; --institution-logo-background: ${education.backgroundColor ?? 'linear-gradient(135deg, rgb(201 162 39 / 0.22), rgb(255 255 255 / 0.06))'}; --institution-logo-color: ${education.color ?? '#e0c359'}`}
          >
            {education.logo ? <education.logo /> : (
              <span>{education.logoAlt}</span>
            )}
          </div>

          <div class="min-w-0 flex-1">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <p class="text-sm font-medium text-[#C9A227]">{education.institution}</p>
                <h3 class="mt-1 text-xl font-semibold text-heading">{education.degree}</h3>
              </div>
            </div>

            <p class="mt-3 text-sm font-medium text-body">
              <time datetime={education.startDateISO}>{education.startDate}</time>
              <span aria-hidden="true"> — </span>
              {education.endDateISO ? (
                <time datetime={education.endDateISO}>{education.endDate}</time>
              ) : (
                <span>{education.endDate}</span>
              )}
            </p>
            <p class="mt-4 max-w-3xl text-base leading-7 text-body">{education.description}</p>
          </div>
        </div>
      </article>
    ))
  }
</div>

<style>
  .education-card {
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.12);
  }

  .institution-logo {
    display: grid;
    width: 4rem;
    height: 4rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--institution-logo-border);
    border-radius: 0.85rem;
    background: var(--institution-logo-background);
    color: var(--institution-logo-color);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.08em;
  }

  .institution-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0.5rem;
  }

  .institution-logo :global(svg) {
    width: 100%;
    height: 100%;
    padding: 0.7rem;
  }
</style>
